      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Fleet Availability",
          "description": "Live % of the fleet not disabled",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "PCC52D03280B7034C"
                      },
                      "spec": {
                        "dataset": "",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  ROUND(100.0 * COUNT(*) FILTER (WHERE NOT is_disabled) / COUNT(*), 1) AS availability_pct\nFROM fact_vehicle_status\nWHERE reported_at = (SELECT MAX(reported_at) FROM fact_vehicle_status)",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
