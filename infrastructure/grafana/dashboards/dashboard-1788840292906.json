                      "spec": {
                        "dataset": "fleet_telemetry",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT vehicle_id, COUNT(*) AS disabled_events\nFROM fact_vehicle_status\nWHERE is_disabled AND $__timeFilter(reported_at)\nGROUP BY vehicle_id\nORDER BY disabled_events DESC\nLIMIT 10",
