      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Battery Health Distribution",
          "description": "Current charge spread across the fleet, with 0% split out",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "PCC52D03280B7034C"
                      },
                      "spec": {
                        "dataset": "fleet_telemetry",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  CASE\n    WHEN battery_level = 0 THEN '0%'\n    WHEN battery_level BETWEEN 1 AND 10 THEN '1-10%'\n    WHEN battery_level BETWEEN 11 AND 20 THEN '11-20%'\n    WHEN battery_level BETWEEN 21 AND 30 THEN '21-30%'\n    WHEN battery_level BETWEEN 31 AND 40 THEN '31-40%'\n    WHEN battery_level BETWEEN 41 AND 50 THEN '41-50%'\n    WHEN battery_level BETWEEN 51 AND 60 THEN '51-60%'\n    WHEN battery_level BETWEEN 61 AND 70 THEN '61-70%'\n    WHEN battery_level BETWEEN 71 AND 80 THEN '71-80%'\n    WHEN battery_level BETWEEN 81 AND 90 THEN '81-90%'\n    ELSE '91-100%'\n  END AS \"Battery Level Range\",\n  COUNT(*) AS \"Number of Vehicles\"\nFROM fact_vehicle_status\nWHERE reported_at = (\n    SELECT MAX(reported_at) FROM fact_vehicle_status WHERE $__timeFilter(reported_at)\n  )\n  AND battery_level IS NOT NULL\nGROUP BY 1\nORDER BY MIN(battery_level)",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
