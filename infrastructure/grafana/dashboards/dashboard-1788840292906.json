      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Top 10 Recurring Problem Vehicles",
          "description": "Vehicles disabled most often",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
